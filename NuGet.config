<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <!-- Every package id resolves from exactly one source. One source today, stated anyway:
       adding a second later without this block is how a package silently starts resolving
       from somewhere nobody chose.

       ⚠ A nuget.config in a subdirectory that maps any pattern to nuget.org REPLACES this
       file's patterns for nuget.org rather than adding to them, so "*" is lost there and every
       other package fails to restore with NU1100. Restate "*" in that file. Mapping only a
       different source, such as a local feed, leaves this mapping in force (measured, SDK 10.0.401). -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- xunit v3 test projects are executables, run on Microsoft.Testing.Platform (global.json). -->
        <OutputType>Exe</OutputType>

        <!-- The library grants internals to this exact assembly name; containment, the extension
             filter, and the mount registry are internal and are the parts worth testing directly. -->
        <AssemblyName>Bennewitz.Ninja.FileServer.Tests</AssemblyName>
    </PropertyGroup>

    <ItemGroup>
        <!-- The component is a Razor class library; testing it in a host needs the ASP.NET Core
             framework reference, which Microsoft.NET.Sdk does not add on its own. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Bennewitz.Ninja.FileServer\Bennewitz.Ninja.FileServer.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Bennewitz.Ninja.AutoVersioning" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
        <PackageReference Include="Microsoft.AspNetCore.TestHost" />
        <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
        <PackageReference Include="xunit.v3" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit" />
        <!-- xunit v3's Fact takes the caller's source location; every derived attribute passes it on. -->
        <Using Include="System.Runtime.CompilerServices" />
    </ItemGroup>

</Project>

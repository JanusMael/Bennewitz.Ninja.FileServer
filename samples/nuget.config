<?xml version="1.0" encoding="utf-8"?>
<!--
  Scoped to samples/ so the local feed cannot affect the library or the CLI build.

  The feed is produced by `pwsh publish/Pack-Local.ps1` and is gitignored: the sample consumes
  the component the way a consumer does, through a package, rather than through a project
  reference that would resolve types the compiler can already see.

  The sample's own package needs both sources: nuget.org for the default, a published release,
  and the local feed for an unreleased build. An exact pattern outranks `*`, so it names nuget.org
  again. And `*` is restated here because patterns under the same source key replace the root
  NuGet.config's, rather than merging with them: mapping this package under nuget.org drops the
  root's `*` for nuget.org, and restore fails NU1100 on every other package. A mapping under a
  different key, like bnfs-local, merges and would not need it.
-->
<configuration>
  <packageSources>
    <add key="bnfs-local" value="../publish/local-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="bnfs-local">
      <package pattern="Bennewitz.Ninja.FileServer" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="Bennewitz.Ninja.FileServer" />
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>

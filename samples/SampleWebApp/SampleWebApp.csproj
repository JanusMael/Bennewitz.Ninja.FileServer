<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>

        <!--
          Defaults to the newest published release, so a fresh clone runs without packing anything
          first. Override it to test an unreleased build — `publish/Pack-Local.ps1` prints the
          version it produced, and CI passes the version it just packed, which is the only way the
          sample verifies the package built in that run rather than the one on nuget.org.
        -->
        <FileServerVersion Condition="'$(FileServerVersion)' == ''">2026.8.18</FileServerVersion>
    </PropertyGroup>

    <ItemGroup>
        <!--
          A PackageReference on purpose, not a ProjectReference. The point of this sample is to
          prove the package carries everything a host needs: compiled views, embedded styles and
          script, and its own dependencies. A project reference would let the compiler see types
          the package might not actually ship, which is exactly the failure this is meant to catch.

          The version comes from the property above so an override reaches it. Hardcoding it here
          leaves the property dead and the override silently ignored.
        -->
        <PackageReference Include="Bennewitz.Ninja.FileServer" Version="$(FileServerVersion)" />
    </ItemGroup>

</Project>

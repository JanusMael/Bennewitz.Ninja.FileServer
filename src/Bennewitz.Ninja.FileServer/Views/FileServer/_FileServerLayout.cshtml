@*
    The component's own layout, used whenever the host does not supply one via
    FileServerMountOptions.LayoutPath. Self-contained: a complete document that needs nothing
    from the host application.

    It renders no sections, matching the views, which never declare any.
*@
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"]</title>
</head>
<body style="margin:0">
@RenderBody()
</body>
</html>
